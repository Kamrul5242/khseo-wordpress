<?xml version="1.0"?>
<ruleset name="KHSEO">
	<description>WordPress Coding Standards for KHSEO.</description>

	<file>khseo.php</file>
	<file>uninstall.php</file>
	<file>config</file>
	<file>src</file>
	<file>templates</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="PHPCompatibilityWP">
		<!-- False positive: PHPCompatibility 9.x does not understand PHP 8.1 enums,
		     where $this is valid. Enum code is verified by php -l and unit tests on 8.1+. -->
		<exclude name="PHPCompatibility.Variables.ForbiddenThisUseContexts"/>
	</rule>

	<!-- Exceptions in the pure kernel/rules layer carry ids from bundled config
	     (never user input) and are never rendered to a page. -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>src/Core/*</exclude-pattern>
		<exclude-pattern>src/Rules/*</exclude-pattern>
	</rule>

	<rule ref="WordPress">
		<!-- PSR-4 class files (src/Foo/BarBaz.php), not class-bar-baz.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- camelCase methods are used consistently in the OOP layer. -->
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName.PropertyNotSnakeCase"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="khseo"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="khseo"/>
				<element value="KHSEO"/>
			</property>
		</properties>
	</rule>
</ruleset>
